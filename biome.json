{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@locusgraph/config/biome/base.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.next",
      "!**/.vinext",
      "!**/.wrangler",
      "!**/migrations"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
