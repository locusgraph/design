{
  "name": "@locusgraph/email",
  "version": "0.3.0",
  "description": "LocusGraph and SpendGraph transactional emails as React templates with inline styles: account, organization, members, API keys, billing, usage and agent approval, with a brand override and createEmails.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locusgraph/design.git",
    "directory": "packages/email"
  },
  "homepage": "https://design.locusgraph.com",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/esm-extensions.mjs dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@locusgraph/tokens": "workspace:*",
    "@locusgraph/utils": "workspace:*"
  },
  "devDependencies": {
    "@locusgraph/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
