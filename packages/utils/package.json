{
  "name": "@locusgraph/utils",
  "version": "0.1.1",
  "description": "Formatting and quota helpers LocusGraph apps share: money in cents and micro-USD, counts, dates and usage status.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locusgraph/design.git",
    "directory": "packages/utils"
  },
  "homepage": "https://design.locusgraph.com",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/esm-extensions.mjs dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@locusgraph/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
