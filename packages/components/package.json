{
  "name": "@locusgraph/components",
  "version": "0.7.0",
  "description": "Radix and shadcn based React components, shells and theme for LocusGraph apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locusgraph/design.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./calendar": "./src/entries/form/calendar.ts",
    "./carousel": "./src/entries/display/carousel.ts",
    "./chart": "./src/entries/display/chart.ts",
    "./combobox": "./src/entries/form/combobox.ts",
    "./command": "./src/entries/overlay/command.ts",
    "./drawer": "./src/entries/overlay/drawer.ts",
    "./hook-form": "./src/entries/form/hook-form.ts",
    "./input-otp": "./src/entries/form/input-otp.ts",
    "./resizable": "./src/entries/layout/resizable.ts",
    "./toaster": "./src/entries/overlay/toaster.ts",
    "./theme.css": "./src/styles/theme.css",
    "./core.css": "./src/styles/core.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./document.css": "./src/styles/document.css",
    "./shadcn.css": "./src/styles/shadcn.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./calendar": {
        "types": "./dist/entries/form/calendar.d.ts",
        "default": "./dist/entries/form/calendar.js"
      },
      "./carousel": {
        "types": "./dist/entries/display/carousel.d.ts",
        "default": "./dist/entries/display/carousel.js"
      },
      "./chart": {
        "types": "./dist/entries/display/chart.d.ts",
        "default": "./dist/entries/display/chart.js"
      },
      "./combobox": {
        "types": "./dist/entries/form/combobox.d.ts",
        "default": "./dist/entries/form/combobox.js"
      },
      "./command": {
        "types": "./dist/entries/overlay/command.d.ts",
        "default": "./dist/entries/overlay/command.js"
      },
      "./drawer": {
        "types": "./dist/entries/overlay/drawer.d.ts",
        "default": "./dist/entries/overlay/drawer.js"
      },
      "./hook-form": {
        "types": "./dist/entries/form/hook-form.d.ts",
        "default": "./dist/entries/form/hook-form.js"
      },
      "./input-otp": {
        "types": "./dist/entries/form/input-otp.d.ts",
        "default": "./dist/entries/form/input-otp.js"
      },
      "./resizable": {
        "types": "./dist/entries/layout/resizable.d.ts",
        "default": "./dist/entries/layout/resizable.js"
      },
      "./toaster": {
        "types": "./dist/entries/overlay/toaster.d.ts",
        "default": "./dist/entries/overlay/toaster.js"
      },
      "./theme.css": "./dist/styles/theme.css",
      "./core.css": "./dist/styles/core.css",
      "./fonts.css": "./dist/styles/fonts.css",
      "./document.css": "./dist/styles/document.css",
      "./shadcn.css": "./dist/styles/shadcn.css"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/styles dist/styles && node ../../scripts/react-compiler.mjs dist && node ../../scripts/esm-extensions.mjs dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@locusgraph/tokens": "workspace:*",
    "@shadcn/react": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "radix-ui": "catalog:",
    "react-day-picker": "catalog:",
    "react-hook-form": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "vaul": "catalog:"
  },
  "devDependencies": {
    "@locusgraph/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "homepage": "https://design.locusgraph.com"
}
