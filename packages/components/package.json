{
  "name": "@locusgraph/components",
  "version": "0.1.0",
  "description": "Radix and shadcn based React components, shells and theme for LocusGraph apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locusgraph/design.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/theme.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./theme.css": "./dist/styles/theme.css"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/styles dist/styles",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource-variable/archivo": "catalog:",
    "@fontsource-variable/fira-code": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@shadcn/react": "catalog:",
    "@spendgraph/config": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react-day-picker": "catalog:",
    "react-hook-form": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "vaul": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "homepage": "https://design.locusgraph.com"
}
