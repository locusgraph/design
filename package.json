{
  "name": "locusgraph-design",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm -r --sort build",
    "dev": "pnpm --filter @locusgraph/design dev",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm registry",
    "check:node": "node scripts/check-node-imports.mjs",
    "registry": "node scripts/registry/build.mjs",
    "registry:test": "node scripts/registry/install-test/run.mjs"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-react-jsx": "catalog:",
    "@biomejs/biome": "catalog:",
    "@locusgraph/config": "workspace:*",
    "@types/node": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  }
}
